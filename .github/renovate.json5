{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "baseBranchPatterns": ["main"],
  "schedule": ["at any time"],
  "enabledManagers": [
    "custom.regex",
    "github-actions",
    "pip_requirements"
  ],
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 10,
  "rebaseWhen": "behind-base-branch",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update pinned upstream add-on images",
      "managerFilePatterns": ["/(^|/)(authentik|bonds|gluetun|n8n|stirling-pdf|traefik-proxy)/Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\nARG UPSTREAM_VERSION=\"(?<currentValue>[^\"]+)\"\\nARG UPSTREAM_DIGEST=\"(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "autoReplaceStringTemplate": "# renovate: datasource={{{datasource}}} depName={{{depName}}} versioning={{{versioning}}}\nARG UPSTREAM_VERSION=\"{{{newValue}}}\"\nARG UPSTREAM_DIGEST=\"{{{newDigest}}}\""
    }
  ],
  "packageRules": [
    {
      "description": "Filter upstream versions; preserve prerelease digest refreshes",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "matchFileNames": [
        "authentik/Dockerfile",
        "bonds/Dockerfile",
        "gluetun/Dockerfile",
        "n8n/Dockerfile",
        "stirling-pdf/Dockerfile",
        "traefik-proxy/Dockerfile"
      ],
      "ignoreUnstable": true,
      "allowedVersions": "/^v?\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z]+)?$/"
    },
    {
      "description": "Automerge validated upstream add-on updates",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "matchFileNames": [
        "authentik/Dockerfile",
        "bonds/Dockerfile",
        "gluetun/Dockerfile",
        "n8n/Dockerfile",
        "stirling-pdf/Dockerfile",
        "traefik-proxy/Dockerfile"
      ],
      "matchUpdateTypes": ["digest", "patch", "minor", "major"],
      "labels": ["dependencies", "addon-upstream", "automerge"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
      "ignoreTests": false
    },
    {
      "description": "Automerge repository tooling",
      "matchManagers": ["github-actions", "pip_requirements"],
      "automerge": true
    }
  ]
}
