#!/bin/sh
set -eu

# Any HTTP response (including redirects and 401) proves uvicorn is serving.
python3 - <<'PY'
import sys
import urllib.error
import urllib.request

try:
    urllib.request.urlopen("http://127.0.0.1:8000/", timeout=4)
except urllib.error.HTTPError:
    pass
except Exception:
    sys.exit(1)
PY
