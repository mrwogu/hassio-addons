#!/bin/sh
set -eu

OPTIONS_PATH=${MEM0_OPTIONS_PATH:-/data/options.json}
CONFIG_DIR=${MEM0_CONFIG_DIR:-/config}
APP_DIR=${MEM0_APP_DIR:-/app}
SECRETS_FILE="${CONFIG_DIR}/.secrets"

# Variables the add-on translates from options; custom env_vars must not
# shadow them or break out of the adapter environment.
MANAGED_ENV="OPENAI_API_KEY OPENAI_BASE_URL ANTHROPIC_API_KEY GOOGLE_API_KEY ADMIN_API_KEY JWT_SECRET AUTH_DISABLED POSTGRES_HOST POSTGRES_PORT POSTGRES_DB POSTGRES_USER POSTGRES_PASSWORD POSTGRES_COLLECTION_NAME APP_DB_NAME MEM0_DEFAULT_LLM_MODEL MEM0_DEFAULT_EMBEDDER_MODEL MEM0_TELEMETRY REQUEST_LOG_RETENTION_DAYS HISTORY_DB_PATH"
PROTECTED_ENV="ADDON_OPTIONS_PATH ADDON_SECRETS_DIR MEM0_ENTRYPOINT PATH HOME IFS ENV BASH_ENV LD_PRELOAD LD_LIBRARY_PATH PYTHONPATH PYTHONUNBUFFERED PYTHONDONTWRITEBYTECODE PIP_NO_CACHE_DIR UVICORN_PORT UVICORN_HOST"

is_listed() {
    list=$1
    candidate=$2
    case " $list " in
        *" $candidate "*) return 0 ;;
        *) return 1 ;;
    esac
}

log() {
    printf '%s\n' "[mem0-addon] $*" >&2
}

fail() {
    log "Error: $*"
    exit 1
}

JQ_DEFS='
    def control_free: (explode | map(select(. < 32 or . == 127)) | length) == 0;
    def nonempty_clean: type == "string" and length > 0 and control_free;
    def optional_clean: type == "string" and control_free;
'

check_option() {
    message=$1
    filter=$2
    jq -e "${JQ_DEFS} ${filter}" "$OPTIONS_PATH" >/dev/null 2>&1 ||
        fail "$message"
}

random_secret() {
    value=$(od -An -N 32 -tx1 /dev/urandom | tr -d ' \n')
    case "$value" in
        *[!0-9a-f]*|"") fail "Cannot generate secret" ;;
    esac
    [ "${#value}" -eq 64 ] || fail "Cannot generate secret"
    printf '%s' "$value"
}

write_secrets() {
    temporary=$(mktemp "${SECRETS_FILE}.tmp.XXXXXX") ||
        fail "Cannot create secrets temporary file"
    if ! jq -n --arg jwt_secret "$stored_jwt_secret" \
        '{jwt_secret: $jwt_secret}' >"$temporary"; then
        rm -f "$temporary"
        fail "Cannot write secrets file"
    fi
    chmod 0600 "$temporary" || {
        rm -f "$temporary"
        fail "Cannot secure secrets file"
    }
    mv -f "$temporary" "$SECRETS_FILE" || {
        rm -f "$temporary"
        fail "Cannot install secrets file"
    }
}

[ -r "$OPTIONS_PATH" ] || fail "Options file is not readable: $OPTIONS_PATH"
command -v jq >/dev/null 2>&1 || fail "jq is required"

jq -e 'type == "object"' "$OPTIONS_PATH" >/dev/null 2>&1 ||
    fail "Invalid options file: expected a JSON object"

# Auth is always enabled; the add-on never exposes AUTH_DISABLED.
check_option "Option 'openai_api_key' is required and must be a non-empty string" \
    '.openai_api_key | nonempty_clean'
check_option "Option 'openai_base_url' must be a string without control characters" \
    '(.openai_base_url // "") | optional_clean'
check_option "Option 'anthropic_api_key' must be a string without control characters" \
    '(.anthropic_api_key // "") | optional_clean'
check_option "Option 'google_api_key' must be a string without control characters" \
    '(.google_api_key // "") | optional_clean'
check_option "Option 'admin_api_key' must be a string without control characters" \
    '(.admin_api_key // "") | optional_clean'
check_option "Option 'jwt_secret' must be a string without control characters" \
    '(.jwt_secret // "") | optional_clean'
check_option "Option 'postgres_host' must be a non-empty string" \
    '.postgres_host | nonempty_clean'
check_option "Option 'postgres_port' must be an integer between 1 and 65535" \
    '.postgres_port | type == "number" and floor == . and . >= 1 and . <= 65535'
check_option "Option 'postgres_db' must be a non-empty string" \
    '.postgres_db | nonempty_clean'
check_option "Option 'postgres_user' must be a non-empty string" \
    '.postgres_user | nonempty_clean'
check_option "Option 'postgres_password' must be a string without control characters" \
    '(.postgres_password // "") | optional_clean'
check_option "Option 'postgres_collection_name' must be a non-empty string" \
    '.postgres_collection_name | nonempty_clean'
check_option "Option 'app_db_name' must be a string without control characters" \
    '(.app_db_name // "") | optional_clean'
check_option "Option 'default_llm_model' must be a non-empty string" \
    '.default_llm_model | nonempty_clean'
check_option "Option 'default_embedder_model' must be a non-empty string" \
    '.default_embedder_model | nonempty_clean'
check_option "Option 'telemetry' must be a boolean" '.telemetry | type == "boolean"'
check_option "Option 'request_log_retention_days' must be a positive integer" \
    '.request_log_retention_days | type == "number" and floor == . and . > 0'
check_option "Option 'env_vars' must be a list of name/value string pairs" \
    '(.env_vars // []) | type == "array" and
        all(.[]; type == "object" and
            (.name | type == "string") and (.value | type == "string"))'

admin_api_key=$(jq -r '.admin_api_key // ""' "$OPTIONS_PATH")
if [ -n "$admin_api_key" ] && [ "${#admin_api_key}" -lt 16 ]; then
    log "Warning: admin_api_key is shorter than 16 characters; use a longer key"
fi

umask 077
mkdir -p "$CONFIG_DIR"

stored_jwt_secret=
if [ -e "$SECRETS_FILE" ]; then
    [ -r "$SECRETS_FILE" ] || fail "Secrets file is not readable"
    if ! jq -e 'type == "object" and ((.jwt_secret // "") | type == "string")' \
        "$SECRETS_FILE" >/dev/null 2>&1; then
        fail "Secrets file is invalid"
    fi
    stored_jwt_secret=$(jq -r '.jwt_secret // ""' "$SECRETS_FILE")
    chmod 0600 "$SECRETS_FILE" || fail "Cannot secure secrets file"
fi

option_jwt_secret=$(jq -r '.jwt_secret // ""' "$OPTIONS_PATH")
secrets_changed=false

if [ -n "$option_jwt_secret" ]; then
    jwt_secret=$option_jwt_secret
elif [ -n "$stored_jwt_secret" ]; then
    jwt_secret=$stored_jwt_secret
else
    stored_jwt_secret=$(random_secret)
    jwt_secret=$stored_jwt_secret
    secrets_changed=true
fi

if [ "$secrets_changed" = true ]; then
    write_secrets
fi

OPENAI_API_KEY=$(jq -r '.openai_api_key' "$OPTIONS_PATH")
OPENAI_BASE_URL=$(jq -r '.openai_base_url // ""' "$OPTIONS_PATH")
ANTHROPIC_API_KEY=$(jq -r '.anthropic_api_key // ""' "$OPTIONS_PATH")
GOOGLE_API_KEY=$(jq -r '.google_api_key // ""' "$OPTIONS_PATH")
JWT_SECRET=$jwt_secret
POSTGRES_HOST=$(jq -r '.postgres_host' "$OPTIONS_PATH")
POSTGRES_PORT=$(jq -r '.postgres_port // 5432' "$OPTIONS_PATH")
POSTGRES_DB=$(jq -r '.postgres_db' "$OPTIONS_PATH")
POSTGRES_USER=$(jq -r '.postgres_user' "$OPTIONS_PATH")
POSTGRES_PASSWORD=$(jq -r '.postgres_password // ""' "$OPTIONS_PATH")
POSTGRES_COLLECTION_NAME=$(jq -r '.postgres_collection_name // "memories"' "$OPTIONS_PATH")
# An empty app_db_name reuses the vector-store database.
APP_DB_NAME=$(jq -r '.app_db_name // ""' "$OPTIONS_PATH")
[ -n "$APP_DB_NAME" ] || APP_DB_NAME=$POSTGRES_DB
MEM0_DEFAULT_LLM_MODEL=$(jq -r '.default_llm_model // "gpt-5-mini"' "$OPTIONS_PATH")
MEM0_DEFAULT_EMBEDDER_MODEL=$(jq -r '.default_embedder_model // "text-embedding-3-small"' "$OPTIONS_PATH")
MEM0_TELEMETRY=$(jq -r 'if .telemetry then "true" else "false" end' "$OPTIONS_PATH")
REQUEST_LOG_RETENTION_DAYS=$(jq -r '.request_log_retention_days // 30' "$OPTIONS_PATH")
HISTORY_DB_PATH="${CONFIG_DIR}/history.db"
ADMIN_API_KEY=$admin_api_key
export OPENAI_API_KEY OPENAI_BASE_URL ANTHROPIC_API_KEY GOOGLE_API_KEY ADMIN_API_KEY JWT_SECRET
export AUTH_DISABLED=false
export POSTGRES_HOST POSTGRES_PORT POSTGRES_DB POSTGRES_USER POSTGRES_PASSWORD
export POSTGRES_COLLECTION_NAME APP_DB_NAME
export MEM0_DEFAULT_LLM_MODEL MEM0_DEFAULT_EMBEDDER_MODEL MEM0_TELEMETRY
export REQUEST_LOG_RETENTION_DAYS HISTORY_DB_PATH

# User-provided environment variables, applied last. Names must be plain
# uppercase identifiers and may never shadow managed or protected variables.
CUSTOM_ENV_NAMES=
env_count=$(jq -r '(.env_vars // []) | length' "$OPTIONS_PATH")
index=0
while [ "$index" -lt "$env_count" ]; do
    name=$(jq -r ".env_vars[$index].name" "$OPTIONS_PATH")
    value=$(jq -r ".env_vars[$index].value" "$OPTIONS_PATH")

    case "$name" in
        [A-Z]*)
            if ! printf '%s' "$name" | grep -Eq '^[A-Z][A-Z0-9_]*$'; then
                fail "Invalid custom environment variable name: $name"
            fi
            ;;
        *) fail "Invalid custom environment variable name: $name" ;;
    esac

    if is_listed "$MANAGED_ENV" "$name"; then
        fail "Custom environment variable overrides managed variable: $name"
    fi
    if is_listed "$PROTECTED_ENV" "$name"; then
        fail "Custom environment variable overrides protected variable: $name"
    fi
    if ! jq -en --arg value "$value" \
        '$value | test("[\u0000-\u001F\u007F]") | not' \
        >/dev/null 2>&1; then
        fail "Custom environment variable contains control characters: $name"
    fi

    export "$name=$value"
    CUSTOM_ENV_NAMES="$CUSTOM_ENV_NAMES $name"
    index=$((index + 1))
done

# Fixture mode for adapter tests: export the environment and exit.
if [ -n "${MEM0_TEST_ENV_FILE:-}" ]; then
    : >"$MEM0_TEST_ENV_FILE"
    while IFS='=' read -r name value; do
        printf '%s=%s\n' "$name" "$value" >>"$MEM0_TEST_ENV_FILE"
    done <<EOF
OPENAI_API_KEY=$OPENAI_API_KEY
OPENAI_BASE_URL=$OPENAI_BASE_URL
ANTHROPIC_API_KEY=$ANTHROPIC_API_KEY
GOOGLE_API_KEY=$GOOGLE_API_KEY
ADMIN_API_KEY=$ADMIN_API_KEY
JWT_SECRET=$jwt_secret
AUTH_DISABLED=$AUTH_DISABLED
POSTGRES_HOST=$POSTGRES_HOST
POSTGRES_PORT=$POSTGRES_PORT
POSTGRES_DB=$POSTGRES_DB
POSTGRES_USER=$POSTGRES_USER
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
POSTGRES_COLLECTION_NAME=$POSTGRES_COLLECTION_NAME
APP_DB_NAME=$APP_DB_NAME
MEM0_DEFAULT_LLM_MODEL=$MEM0_DEFAULT_LLM_MODEL
MEM0_DEFAULT_EMBEDDER_MODEL=$MEM0_DEFAULT_EMBEDDER_MODEL
MEM0_TELEMETRY=$MEM0_TELEMETRY
REQUEST_LOG_RETENTION_DAYS=$REQUEST_LOG_RETENTION_DAYS
HISTORY_DB_PATH=$HISTORY_DB_PATH
EOF
    for name in $CUSTOM_ENV_NAMES; do
        eval "value=\$$name"
        printf '%s=%s\n' "$name" "$value" >>"$MEM0_TEST_ENV_FILE"
    done
    exit 0
fi

cd /app
[ -f "${APP_DIR}/main.py" ] || fail "Mem0 server files are missing in ${APP_DIR}"
log "Running database migrations"
alembic upgrade head
log "Configuration validated; starting Mem0 REST server"
exec python3 -m uvicorn main:app --host 0.0.0.0 --port 8000
