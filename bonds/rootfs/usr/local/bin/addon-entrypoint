#!/bin/sh
set -eu

OPTIONS_PATH=${BONDS_OPTIONS_PATH:-/data/options.json}
CONFIG_DIR=${BONDS_CONFIG_DIR:-/config}
BONDS_BIN=${BONDS_EXECUTABLE:-/app/bonds-server}
SECRETS_FILE="${CONFIG_DIR}/.secrets"

log() {
    printf '%s\n' "[bonds-addon] $*" >&2
}

fail() {
    log "Error: $*"
    exit 1
}

dsn_quote() {
    # Quote values for the lib/pq-style key-value DSN accepted by Bonds.
    printf '%s' "$1" | sed "s/[\\\\']/\\\\&/g"
}

JQ_DEFS='
    def control_free: (explode | map(select(. < 32 or . == 127)) | length) == 0;
    def nonempty_clean: type == "string" and length > 0 and control_free;
    def optional_clean: type == "string" and control_free;
'

check_option() {
    message=$1
    filter=$2
    jq -e "${JQ_DEFS} ${filter}" "$OPTIONS_PATH" >/dev/null 2>&1 ||
        fail "$message"
}

normalize_backup_cron() {
    (
        set -f
        IFS=' '
        # Word splitting is intentional after pathname expansion is disabled.
        # shellcheck disable=SC2086
        set -- $1
        case "$#" in
            5) set -- 0 "$@" ;;
            6) ;;
            *) exit 1 ;;
        esac
        printf '%s' "$1"
        shift
        for field in "$@"; do
            printf ' %s' "$field"
        done
        printf '\n'
    )
}

random_secret() {
    value=$(od -An -N 32 -tx1 /dev/urandom | tr -d ' \n')
    case "$value" in
        *[!0-9a-f]*|"") fail "Cannot generate secret" ;;
    esac
    [ "${#value}" -eq 64 ] || fail "Cannot generate secret"
    printf '%s' "$value"
}

write_secrets() {
    temporary=$(mktemp "${SECRETS_FILE}.tmp.XXXXXX") ||
        fail "Cannot create secrets temporary file"
    if ! jq -n \
        --arg jwt_secret "$stored_jwt_secret" \
        --arg settings_encryption_key "$stored_settings_key" \
        '{
            jwt_secret: $jwt_secret,
            settings_encryption_key: $settings_encryption_key
        }' >"$temporary"; then
        rm -f "$temporary"
        fail "Cannot write secrets file"
    fi
    chmod 0600 "$temporary" || {
        rm -f "$temporary"
        fail "Cannot secure secrets file"
    }
    mv -f "$temporary" "$SECRETS_FILE" || {
        rm -f "$temporary"
        fail "Cannot install secrets file"
    }
}

[ -r "$OPTIONS_PATH" ] || fail "Options file is not readable: $OPTIONS_PATH"
command -v jq >/dev/null 2>&1 || fail "jq is required"
[ -x "$BONDS_BIN" ] || fail "Bonds executable is not executable: $BONDS_BIN"

jq -e 'type == "object"' "$OPTIONS_PATH" >/dev/null 2>&1 ||
    fail "Invalid options file: expected a JSON object"

database=$(jq -r '.database // "sqlite"' "$OPTIONS_PATH")
case $database in
    sqlite | postgres) ;;
    *) fail "Option 'database' must be sqlite or postgres" ;;
esac

postgres_sslmode=$(jq -r '.postgres_sslmode // "require"' "$OPTIONS_PATH")
case $postgres_sslmode in
    disable | require | verify-full) ;;
    *)
        fail "Option 'postgres_sslmode' must be disable, require or verify-full"
        ;;
esac

check_option "Option 'app_url' must be a non-empty string" \
    '.app_url | nonempty_clean'
check_option "Option 'jwt_secret' must be a string without control characters" \
    '(.jwt_secret // "") | optional_clean'
check_option "Option 'settings_encryption_key' must be a string without control characters" \
    '(.settings_encryption_key // "") | optional_clean'
check_option "Option 'storage_max_size_mb' must be a positive integer" \
    '.storage_max_size_mb | type == "number" and floor == . and . > 0'
check_option "Option 'backup_cron' must be a string without control characters" \
    '(.backup_cron // "0 0 3 * * *") | optional_clean'
check_option "Option 'backup_retention_days' must be a positive integer" \
    '.backup_retention_days | type == "number" and floor == . and . > 0'
check_option "Option 'debug' must be a boolean" '.debug | type == "boolean"'
check_option "Option 'postgres_host' must be a string without control characters" \
    '(.postgres_host // "") | optional_clean'
check_option "Option 'postgres_port' must be an integer between 1 and 65535" \
    '(.postgres_port // 5432) |
        type == "number" and floor == . and . >= 1 and . <= 65535'
check_option "Option 'postgres_db' must be a string without control characters" \
    '(.postgres_db // "") | optional_clean'
check_option "Option 'postgres_user' must be a string without control characters" \
    '(.postgres_user // "") | optional_clean'
check_option "Option 'postgres_password' must be a string without control characters" \
    '(.postgres_password // "") | optional_clean'

backup_cron=$(jq -r '.backup_cron // "0 0 3 * * *"' "$OPTIONS_PATH")
if ! backup_cron=$(normalize_backup_cron "$backup_cron"); then
    fail "Option 'backup_cron' must contain exactly 5 or 6 fields"
fi

if [ "$database" = postgres ]; then
    for option in postgres_host postgres_db postgres_user; do
        check_option "Option '${option}' is required when database is postgres" \
            "(.${option} // \"\") | nonempty_clean"
    done
fi

umask 077
mkdir -p "$CONFIG_DIR"

stored_jwt_secret=
stored_settings_key=
if [ -e "$SECRETS_FILE" ]; then
    [ -r "$SECRETS_FILE" ] || fail "Secrets file is not readable"
    if ! jq -e '
        type == "object" and
        ((.jwt_secret // "") | type == "string") and
        ((.settings_encryption_key // "") | type == "string")
    ' "$SECRETS_FILE" >/dev/null 2>&1; then
        fail "Secrets file is invalid"
    fi
    stored_jwt_secret=$(jq -r '.jwt_secret // ""' "$SECRETS_FILE")
    stored_settings_key=$(jq -r '.settings_encryption_key // ""' "$SECRETS_FILE")
    chmod 0600 "$SECRETS_FILE" || fail "Cannot secure secrets file"
fi

option_jwt_secret=$(jq -r '.jwt_secret // ""' "$OPTIONS_PATH")
option_settings_key=$(jq -r '.settings_encryption_key // ""' "$OPTIONS_PATH")
secrets_changed=false

if [ -n "$option_jwt_secret" ]; then
    jwt_secret=$option_jwt_secret
elif [ -n "$stored_jwt_secret" ]; then
    jwt_secret=$stored_jwt_secret
else
    stored_jwt_secret=$(random_secret)
    jwt_secret=$stored_jwt_secret
    secrets_changed=true
fi

if [ -n "$option_settings_key" ]; then
    settings_key=$option_settings_key
elif [ -n "$stored_settings_key" ]; then
    settings_key=$stored_settings_key
else
    stored_settings_key=$(random_secret)
    settings_key=$stored_settings_key
    secrets_changed=true
fi

if [ "$secrets_changed" = true ]; then
    write_secrets
fi

export SERVER_PORT=8080
export SERVER_HOST=0.0.0.0
if [ "$database" = "postgres" ]; then
    postgres_host=$(jq -r '.postgres_host' "$OPTIONS_PATH")
    postgres_port=$(jq -r '.postgres_port // 5432' "$OPTIONS_PATH")
    postgres_db=$(jq -r '.postgres_db' "$OPTIONS_PATH")
    postgres_user=$(jq -r '.postgres_user' "$OPTIONS_PATH")
    postgres_password=$(jq -r '.postgres_password // ""' "$OPTIONS_PATH")
    if [ -f "${CONFIG_DIR}/bonds.db" ]; then
        log "Warning: ${CONFIG_DIR}/bonds.db stays unused in postgres mode;" \
            "migrate its contents before relying on PostgreSQL"
    fi
    dsn="host='$(dsn_quote "$postgres_host")'"
    dsn="$dsn port='$(dsn_quote "$postgres_port")'"
    dsn="$dsn user='$(dsn_quote "$postgres_user")'"
    # An explicit empty password shadows PGPASSFILE and peer authentication.
    if [ -n "$postgres_password" ]; then
        dsn="$dsn password='$(dsn_quote "$postgres_password")'"
    fi
    dsn="$dsn dbname='$(dsn_quote "$postgres_db")'"
    dsn="$dsn sslmode='${postgres_sslmode}'"
    export DB_DRIVER=postgres
    export "DB_DSN=$dsn"
else
    export DB_DRIVER=sqlite
    export "DB_DSN=${CONFIG_DIR}/bonds.db"
fi
export "JWT_SECRET=$jwt_secret"
export "SETTINGS_ENC_KEY=$settings_key"
export APP_ENV=production
export "DEBUG=$(jq -r '.debug' "$OPTIONS_PATH")"
export "APP_URL=$(jq -r '.app_url' "$OPTIONS_PATH")"
export "STORAGE_UPLOAD_DIR=${CONFIG_DIR}/uploads"
export "STORAGE_MAX_SIZE_MB=$(jq -r '.storage_max_size_mb' "$OPTIONS_PATH")"
export "BLEVE_INDEX_PATH=${CONFIG_DIR}/bonds.bleve"
export "BACKUP_DIR=${CONFIG_DIR}/backups"
export "BACKUP_CRON=$backup_cron"
export "BACKUP_RETENTION=$(jq -r '.backup_retention_days' "$OPTIONS_PATH")"

log "Configuration validated; starting Bonds"
exec "$BONDS_BIN" "$@"
